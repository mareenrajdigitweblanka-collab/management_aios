DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE

# Optional. Comma-separated list of allowed CORS origins. Whitespace around
# each entry is trimmed. Falls back to https://management-aios.vercel.app if
# unset. Localhost/127.0.0.1 (any port) is always allowed separately for
# local development — see backend/config.py.
ALLOWED_ORIGINS=https://management-aios.vercel.app

# Optional. Informational only; not currently used to change runtime
# behavior. Defaults to "development" if unset.
ENVIRONMENT=production

# Required. Calendar member-token authorization (backend/config.py,
# backend/routers/calendar_auth.py). Each value is the SHA-256 hexadecimal
# digest (64 lowercase hex characters) of that member's own secret token —
# NEVER the raw token itself. All five must be set, non-blank, valid
# 64-character hex digests, and unique across members, or the backend
# fails closed at startup. Placeholder values only — generate real tokens
# out-of-band and hash them (e.g. `python -c "import hashlib;
# print(hashlib.sha256(b'REPLACE_WITH_REAL_TOKEN').hexdigest())"`); never
# commit a real token or its hash to this file or any tracked file.
CALENDAR_AUTH_TOKEN_HASH_MAYURIKA=set_a_real_token_hash_here
CALENDAR_AUTH_TOKEN_HASH_SUMAN=set_a_real_token_hash_here
CALENDAR_AUTH_TOKEN_HASH_ARUN=set_a_real_token_hash_here
CALENDAR_AUTH_TOKEN_HASH_RAJIV=set_a_real_token_hash_here
CALENDAR_AUTH_TOKEN_HASH_PARAPARAN=set_a_real_token_hash_here

# Optional (REQ-CAL-REV-MD-READ-006). MD's separate, read-only Review
# Summary token hash — same SHA-256 hex digest format as the five required
# tokens above, but this one is NOT required: if unset, blank, or left as
# the placeholder value below, MD authorization is simply unavailable
# (every MD-token request fails closed with 401) — the backend does not
# fail to start, and the five member tokens above are unaffected either
# way. See backend/config.py load_md_review_summary_token_hash. Never
# commit a real token or its hash to this file or any tracked file.
CALENDAR_AUTH_TOKEN_HASH_MD=set_a_real_token_hash_here
